# Server Configuration
PORT=3001
NODE_ENV=development

# Security - CHANGE THESE IN PRODUCTION
JWT_SECRET=change-this-to-a-strong-random-secret-512-bits
DB_ENCRYPTION_KEY=change-this-to-a-strong-random-key-256-bits

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Production example:
# NODE_ENV=production
# JWT_SECRET=your-production-secret-here
# DB_ENCRYPTION_KEY=your-production-key-here
# ALLOWED_ORIGINS=https://yourdomain.com
